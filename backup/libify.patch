diff --git a/Cargo.toml b/Cargo.toml
index 9413a1c27..099a916b3 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -26,10 +26,15 @@ include = [
         "/vendored_parsers/highlights/*.scm",
         "/vendored_parsers/*-src/**/*.c",
         "/vendored_parsers/*-src/**/*.h",
+        "/vendored_parsers/*-src/**/*.cc",
         "/LICENSE",
         "/README.md",
 ]
 
+[lib]
+name = "difftastic_core"
+path = "src/lib.rs"
+
 [package.metadata.binstall]
 pkg-url = "{ repo }/releases/download/{ version }/difft-{ version }-{ target }.{ archive-format }"
 
